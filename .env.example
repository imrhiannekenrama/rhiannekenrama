# Supabase Project Settings → API Keys / Connect
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Supabase secret/service-role key - only for server-side signed downloads and contact submissions.
# NEVER prefix with NEXT_PUBLIC_ and NEVER commit an actual secret!
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Public origin, used for canonical / share links. Set to https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
